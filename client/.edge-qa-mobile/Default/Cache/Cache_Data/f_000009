ottom: calc(92px + env(safe-area-inset-bottom));\n  }\n\n  .section {\n    padding: 4rem 0;\n  }\n\n  .page-hero__content,\n  .section,\n  .profile-hero,\n  .footer__grid,\n  .footer__bottom {\n    width: min(100vw - 1.5rem, var(--container));\n  }\n\n  .hero-slider__controls {\n    display: none;\n  }\n\n  .mobile-nav {\n    display: block;\n  }\n\n  .mobile-nav__bar {\n    position: fixed;\n    inset: auto 0 0;\n    z-index: 39;\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    padding: 0.8rem 0.6rem calc(0.8rem + env(safe-area-inset-bottom));\n    background: rgba(250, 248, 245, 0.94);\n    border-top: 1px solid rgba(201, 168, 76, 0.2);\n    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.08);\n    backdrop-filter: blur(14px);\n  }\n\n  .mobile-nav__item {\n    position: relative;\n    display: grid;\n    place-items: center;\n    gap: 0.25rem;\n    padding: 0.55rem 0.3rem;\n    color: var(--color-muted);\n  }\n\n  .mobile-nav__item.active {\n    color: var(--color-crimson);\n  }\n\n  .mobile-nav__item span {\n    font-family: var(--font-accent);\n    font-size: 0.6rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .mobile-nav__fab {\n    position: fixed;\n    inset: auto 50% calc(4.7rem + env(safe-area-inset-bottom)) auto;\n    transform: translateX(50%);\n    z-index: 40;\n    width: 62px;\n    height: 62px;\n    border-radius: 999px;\n    background: linear-gradient(135deg, var(--color-light-gold), var(--color-gold));\n    color: var(--color-primary);\n    box-shadow: 0 18px 35px rgba(201, 168, 76, 0.34);\n  }\n\n  .chatbot {\n    inset: auto 50% calc(5.6rem + env(safe-area-inset-bottom)) auto;\n    transform: translateX(50%);\n  }\n\n  .chatbot__window {\n    width: min(100vw - 1rem, 420px);\n    height: min(74vh, 520px);\n  }\n\n  .footer__grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 560px) {\n  .section-heading h2,\n  .intro-grid h1,\n  .page-hero__content h1 {\n    font-size: clamp(2.2rem, 9vw, 3.2rem);\n  }\n\n  .profile-hero,\n  .booking-modal,\n  .modal-card {\n    padding: 1.15rem;\n  }\n\n  .metrics-panel,\n  .dashboard-kpi-grid,\n  .founders-grid,\n  .attractions-grid,\n  .reach-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .room-detail__gallery {\n    grid-template-columns: 1fr;\n  }\n\n  .chatbot__window {\n    width: calc(100vw - 1rem);\n    height: 76vh;\n  }\n}\n\n/* ==========================================================================\n   ADVANCED HOME LAYOUTS (BENTO GRID & STICKY SCROLL)\n   ========================================================================== */\n\n/* ── Trust Badges ── */\n.trust-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  justify-content: center;\n  margin: 2.5rem 0;\n}\n.trust-badge {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0.65rem 1.1rem;\n  border-radius: 99px;\n  background: rgba(255, 255, 255, 0.7);\n  border: 1px solid rgba(201, 168, 76, 0.28);\n  backdrop-filter: blur(10px);\n  box-shadow: 0 4px 16px rgba(0,0,0,0.06);\n  transition: all 0.3s ease;\n  cursor: default;\n}\n.trust-badge:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 28px rgba(123, 26, 26, 0.12);\n  border-color: rgba(201, 168, 76, 0.5);\n}\n.trust-badge__icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #1a1a1a, #7b1a1a);\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n}\n.trust-badge__title {\n  font-weight: 700;\n  font-size: 0.82rem;\n  color: #1a1a1a;\n}\n.trust-badge__sub {\n  font-size: 0.7rem;\n  color: #8f8579;\n}\n\n/* ── Bento Grid ── */\n.bento-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  grid-auto-rows: 240px;\n  gap: 1.25rem;\n  width: var(--container);\n  margin: 0 auto;\n}\n.bento-item {\n  position: relative;\n  border-radius: 24px;\n  overflow: hidden;\n  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 8px 30px rgba(0,0,0,0.06);\n}\n.bento-item:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 20px 40px rgba(0,0,0,0.12);\n}\n.bento-item img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.bento-item:hover img {\n  transform: scale(1.08);\n}\n.bento-content {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 2rem;\n  background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, transparent 100%);\n  color: #fff;\n  z-index: 2;\n}\n.bento-content h3 {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.5rem;\n  margin-bottom: 0.5rem;\n}\n.bento-content p {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.1rem;\n  color: rgba(255,255,255,0.8);\n}\n.bento-solid {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  padding: 2rem;\n  color: #fff;\n  text-align: center;\n}\n.bento-solid h3 {\n  font-family: 'Playfair Display', serif;\n  font-size: 2.5rem;\n  margin-bottom: 0.25rem;\n  background: linear-gradient(135deg, #c9a84c, #e8d5a3);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n.bento-solid p {\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-size: 0.8rem;\n  color: rgba(255,255,255,0.6);\n}\n.bento-tall {\n  grid-column: span 2;\n  grid-row: span 2;\n}\n.bento-wide {\n  grid-column: span 2;\n  grid-row: span 1;\n}\n.bento-square {\n  grid-column: span 1;\n  grid-row: span 1;\n}\n\n@media (max-width: 900px) {\n  .bento-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n@media (max-width: 600px) {\n  .bento-grid {\n    grid-template-columns: 1fr;\n    grid-auto-rows: minmax(240px, auto);\n  }\n  .bento-tall, .bento-wide, .bento-square {\n    grid-column: span 1;\n  }\n}\n\n/* ── Sticky Scroll Section ── */\n.sticky-section {\n  background: linear-gradient(180deg, #1a1a1a 0%, #2c1a1a 100%);\n  color: #faf8f5;\n  position: relative;\n  padding: 6rem 0;\n}\n.sticky-container {\n  width: var(--container);\n  margin: 0 auto;\n  display: flex;\n  gap: 4rem;\n  align-items: flex-start;\n}\n.sticky-left {\n  flex: 1;\n  position: sticky;\n  top: 120px;\n  height: calc(100vh - 160px);\n  min-height: 500px;\n}\n.sticky-image-wrapper {\n  width: 100%;\n  height: 100%;\n  border-radius: 24px;\n  overflow: hidden;\n  position: relative;\n}\n.sticky-image-wrapper img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  filter: brightness(0.7);\n}\n.sticky-overlay {\n  position: absolute;\n  inset: 0;\n  padding: 3rem;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);\n}\n.sticky-overlay h2 {\n  font-family: 'Playfair Display', serif;\n  font-size: clamp(2rem, 4vw, 3rem);\n  line-height: 1.1;\n  margin-top: 1rem;\n}\n.sticky-overlay p {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.2rem;\n  color: rgba(255,255,255,0.7);\n  margin-top: 1rem;\n  max-width: 400px;\n}\n.sticky-right {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n  padding: 4rem 0;\n}\n.sticky-card {\n  background: rgba(255,255,255,0.03);\n  border: 1px solid rgba(201, 168, 76, 0.1);\n  padding: 2.5rem;\n  border-radius: 24px;\n  position: relative;\n  transition: all 0.3s ease;\n}\n.sticky-card:hover {\n  background: rgba(255,255,255,0.06);\n  border-color: rgba(201, 168, 76, 0.3);\n  transform: translateX(-10px);\n}\n.sticky-card__number {\n  font-family: 'Cinzel', serif;\n  font-size: 4rem;\n  line-height: 1;\n  color: rgba(201, 168, 76, 0.15);\n  position: absolute;\n  top: 1rem;\n  right: 1.5rem;\n  font-weight: 600;\n}\n.sticky-card h3 {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.5rem;\n  margin-bottom: 1rem;\n  color: #faf8f5;\n}\n.sticky-card p {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.1rem;\n  line-height: 1.7;\n  color: rgba(250,248,245,0.68);\n}\n\n@media (max-width: 900px) {\n  .sticky-container {\n    flex-direction: column;\n  }\n  .sticky-left {\n    position: relative;\n    top: 0;\n    height: 60vh;\n    width: 100%;\n  }\n  .sticky-right {\n    padding: 0;\n    width: 100%;\n  }\n  .sticky-card:hover {\n    transform: none;\n  }\n}\n\n/* ── Pull Quote ── */\n.pull-quote-section {\n  background: linear-gradient(135deg, rgba(201,168,76,0.08), rgba(123,26,26,0.05));\n  border-top: 1px solid rgba(201,168,76,0.15);\n  border-bottom: 1px solid rgba(201,168,76,0.15);\n}\n.pull-quote-container {\n  width: var(--container);\n  margin: 0 auto;\n  padding: 4rem 0;\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  justify-content: center;\n  text-align: center;\n  flex-direction: column;\n}\n.pull-quote-container blockquote {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: clamp(1.4rem, 3vw, 2.2rem);\n  line-height: 1.6;\n  color: #1a1a1a;\n  max-width: 800px;\n  font-style: italic;\n}\n.pull-quote-author {\n  font-family: 'Cinzel', serif;\n  font-size: 0.78rem;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: #7b1a1a;\n}\n.pull-quote-location {\n  font-size: 0.78rem;\n  color: #8f8579;\n  margin-top: 4px;\n}\n\n/* ── CTA Banner ── */\n.cta-banner {\n  background: linear-gradient(135deg, #1a1a1a 0%, #2c1a1a 60%, #1a1a1a 100%);\n  border-top: 1px solid rgba(201,168,76,0.2);\n}\n.cta-banner-content {\n  width: var(--container);\n  margin: 0 auto;\n  padding: 5rem 0;\n  display: grid;\n  place-items: center;\n  text-align: center;\n  gap: 1.5rem;\n}\n.cta-banner-content h2 {\n  font-family: 'Playfair Display', serif;\n  font-size: clamp(2rem, 4vw, 3.2rem);\n  background: linear-gradient(135deg, #faf8f5, #e8d5a3);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  line-height: 1.1;\n  max-width: 680px;\n}\n.cta-banner-content p {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.1rem;\n  color: rgba(250,248,245,0.65);\n  max-width: 480px;\n  line-height: 1.7;\n}\n.cta-actions {\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n\n/* ── Intro Content (Centered) ── */\n.intro-content {\n  max-width: 800px;\n  margin: 0 auto;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1.5rem;\n}\n.intro-content h1 {\n  font-family: 'Playfair Display', serif;\n  font-size: clamp(2.5rem, 5vw, 4.5rem);\n  line-height: 1.1;\n  color: var(--color-charcoal);\n  margin: 0.5rem 0;\n}\n.intro-content p {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.2rem;\n  line-height: 1.7;\n  color: var(--color-charcoal);\n  opacity: 0.8;\n  max-width: 600px;\n}\n.intro-actions {\n  display: flex;\n  gap: 1rem;\n  justify-content: center;\n  margin-top: 1rem;\n}\n\n/* ── Chatbot Action Buttons ── */\n.chatbot-action-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: rgba(201, 168, 76, 0.15);\n  border: 1px solid rgba(201, 168, 76, 0.3);\n  color: #c9a84c;\n  padding: 8px 12px;\n  border-radius: 8px;\n  font-size: 0.85rem;\n  font-weight: 500;\n  text-decoration: none;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.chatbot-action-btn:hover {\n  background: rgba(201, 168, 76, 0.25);\n  transform: translateY(-1px);\n}\n\n/* ── Video Showcase Section (Reels) ── */\n.video-showcase-section {\n  padding-block: 4rem;\n  background: var(--color-light);\n  overflow: hidden;\n}\n\n.video-showcase-container {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1rem;\n  padding: 0 5%;\n  margin-top: 2rem;\n}\n\n.video-reel {\n  position: relative;\n  aspect-ratio: 9 / 16;\n  border-radius: 20px;\n  overflow: hidden;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n  cursor: pointer;\n  background: #000;\n}\n\n.video-reel:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 20px 40px rgba(201, 168, 76, 0.2);\n}\n\n.video-reel__media {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  displ